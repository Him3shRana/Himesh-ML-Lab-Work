  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "## Step 3: Handling Missing Values",
   "id": "b9f2c0f2e54e32fd"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-07T18:42:57.370444300Z",
     "start_time": "2026-09-07T18:42:57.331174600Z"
    }
   },
   "cell_type": "code",
   "source": [
    "df_demo = df.copy()\n",
    "df_demo.loc[2, 'TOC'] = np.nan\n",
    "df_demo.loc[5, 'MACHINE LEARNING '] = np.nan\n",
    "print(df_demo.isnull().sum())\n",
    "\n",
    "# 2a. Drop rows with missing values\n",
    "df_dropped = df_demo.dropna()\n",
    "\n",
    "# 2b. Fill numeric columns with mean\n",
    "df_filled = df_demo.copy()\n",
    "numeric_cols = df_filled.select_dtypes(include=['float64', 'int64']).columns\n",
    "df_filled[numeric_cols] = df_filled[numeric_cols].fillna(df_filled[numeric_cols].mean())\n",
    "\n",
    "# 2c. Fill categorical columns with mode\n",
    "categorical_cols = df_filled.select_dtypes(include=['object', 'str']).columns\n",
    "for col in categorical_cols:\n",
    "    df_filled[col] = df_filled[col].fillna(df_filled[col].mode()[0])\n",
    "\n",
    "print(df_filled.isnull().sum())\n",
    "\n"
   ],
